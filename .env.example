# --- PostgreSQL ---
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- SQLAlchemy (asyncpg) ---
DATABASE_URL=postgresql+asyncpg://rag_user:change_me@localhost:5432/rag_db
SQL_ECHO=false

# --- Embedding (384 boyutlu) ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- Güvenlik ---
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Belge işleme ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
CHUNK_SIZE=600
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_SEQ_LENGTH=256

# --- LLM ---
# LLM_PROVIDER: ollama | openai | anthropic | gemini
# Örnekler:
#   gemini    -> LLM_MODEL=gemini-3.5-flash-lite  (LLM_BASE_URL kullanılmaz, anahtar AI Studio'dan)
#   ollama    -> LLM_MODEL=qwen2.5:7b             LLM_BASE_URL=http://localhost:11434
#   anthropic -> LLM_MODEL=claude-sonnet-5-5      LLM_BASE_URL=https://api.anthropic.com
# Sağlayıcıyı değiştirirsen LLM_MODEL ve LLM_BASE_URL'yi de güncelle
# (boş bırakırsan sağlayıcının varsayılanı kullanılır).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_NUM_CTX=4096
LLM_TIMEOUT_SECONDS=180

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.1
HNSW_EF_SEARCH=100
MAX_CONTEXT_CHARS=6000
MAX_HISTORY_MESSAGES=6

# --- Hibrit arama (pgvector + tam metin araması, RRF) ---
HYBRID_SEARCH_ENABLED=true
HYBRID_CANDIDATES=20
HYBRID_RRF_K=60
HYBRID_VECTOR_WEIGHT=1.0
HYBRID_FTS_WEIGHT=1.0
HYBRID_FTS_MIN_SCORE=0.05

# --- Belge özeti / tam metin / soru yönlendirme ---
SUMMARY_ENABLED=true
FULL_TEXT_MAX_CHARS=600000
FULL_TEXT_CONTEXT_MAX_CHARS=400000
ROUTE_SUMMARY_MAX_DOCS=10

# --- Sohbet geçmişi ve çoklu belge kapsamı ---
CHAT_HISTORY_DB_LIMIT=20
SESSION_TITLE_MAX_CHARS=60
SESSION_MESSAGES_MAX=500
MAX_SCOPE_DOCUMENTS=20
FULL_TEXT_MAX_DOCS=3

# --- Yeniden sıralama: off | score | cross_encoder ---
# score: modelsiz, hafif filtre (varsayılan). cross_encoder: ilk kullanımda ~470 MB model iner.
RERANK_MODE=score
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=15
RERANK_BATCH_SIZE=16
RERANK_MAX_LENGTH=512
RERANK_MIN_SCORE=
RERANK_RELATIVE_CUTOFF=0.5
RERANK_MIN_KEEP=2

# --- İstek sınırlama (kullanıcı başına, süreç içi) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DEFAULT=120/minute

# --- Streamlit arayüzü ---
API_BASE_URL=http://localhost:8000
STATUS_POLL_SECONDS=3
API_TIMEOUT_SECONDS=30
CHAT_TIMEOUT_SECONDS=200
DEFAULT_TOP_K=5
